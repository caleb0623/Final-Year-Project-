# Copy this file to .env and replace every placeholder.
# Never commit .env or expose the secret key to browser code.

# Flask session signing key: any long random string.
ATTIRE_WEB_SECRET=replace-with-a-long-random-secret

# Supabase Postgres via the Session pooler (Dashboard > Connect > Session pooler), using the
# SQLAlchemy psycopg scheme. URL-encode special characters in the password (? -> %3F, ! -> %21).
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Storage (private bucket; created automatically on first start).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=replace-with-server-only-sb_secret-key
SUPABASE_STORAGE_BUCKET=student-faces

# Models (face models are in models/; provide the trained YOLOv7 attire weights yourself).
FACE_DETECTOR_MODEL=models/face_detection_yunet_2023mar.onnx
FACE_RECOGNIZER_MODEL=models/face_recognition_sface_2021dec.onnx
YOLO_WEIGHTS=models/attire-best.pt
# FACE_MATCH_THRESHOLD=0.363
# AUTO_RETURN_CONFIRMATIONS=2

# Optional SMTP for emailing reports and password-reset codes.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
